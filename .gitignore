# log files
logs/
*.log

# font storages
fonts-storage/


# ── GitBook Worker build outputs ──────────────────────────────
book/en/publish/
book/de/publish/
book/fonts-storage/
book/.gitbook-content/

# ── Standalone publish outputs (root publish.yml) ────────────
publish/*.pdf
publish/temp/

# ── Collected chapter content (copied by build-book.ps1) ─────
# The build script copies source MDs into sub-chapter dirs.
# We track the chapter *structure* (topic READMEs, DOI appendices)
# but ignore the build-populated sub-chapter content directories.
# EN sub-chapter content (build-copied)
book/en/content/chapters/*/1.1-design/
book/en/content/chapters/*/1.2-variants/
book/en/content/chapters/*/1.3-v2/
book/en/content/chapters/*/1.4-design-improvements/
book/en/content/chapters/*/1.5-cost-estimation/
book/en/content/chapters/*/1.6-the-peoples-house/
book/en/content/chapters/*/2.1-article/
book/en/content/chapters/*/3.1-article/
# DE sub-chapter content (build-copied)
book/de/content/chapters/*/1.1-entwurf/
book/de/content/chapters/*/1.2-varianten/
book/de/content/chapters/*/1.3-v2/
book/de/content/chapters/*/1.4-design-verbesserungen/
book/de/content/chapters/*/1.5-kostenschaetzung/
book/de/content/chapters/*/2.1-artikel/
book/de/content/chapters/*/3.1-artikel/

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json

# ── Python venv (if gitbook-worker is installed locally) ─────
.venv/
__pycache__/
*.pyc
