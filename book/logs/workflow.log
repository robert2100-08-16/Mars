  \end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
  Advanced Package
  \end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
  Prototype Benchmark
  \end{minipage} \\
  \midrule\noalign{}
  \endhead
  \bottomrule\noalign{}
