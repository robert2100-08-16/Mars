  \subsubsection{1. Two-Story Rubber-Glass
  House}\label{two-story-rubber-glass-house}
  
  \paragraph{Floor Plan and Structure}\label{floor-plan-and-structure}
  
  \begin{itemize}
  \tightlist
  \item
    \textbf{Total Area:} 1000 m² (50 m x 20 m) per level, 2000 m² total
