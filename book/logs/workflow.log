  \end{minipage} & \begin{minipage}[b]{\linewidth}\raggedright
  Processing
  \end{minipage} \\
  \midrule\noalign{}
  \endhead
  \bottomrule\noalign{}
  \endlastfoot
  \textbf{SiO\_\{2\} (silicon dioxide)} & Regolith (\textasciitilde45\%
  SiO\_\{2\}) & Abundant & Glass, silicone rubber, aerogel \\
  \textbf{Fe\_\{2\}O\_\{3\} (iron oxide)} & Regolith (\textasciitilde18\%
  Fe\_\{2\}O\_\{3\}) & Abundant & Iron/steel for tools, structures \\
  \textbf{CO\_\{2\}} & Atmosphere (95.3\%) & Effectively unlimited &
  Sabatier → CH\_\{4\} + O\_\{2\}; feedstock for plant growth \\
  \textbf{N\_\{2\}} & Atmosphere (2.7\%) & Limited but extractable &
  Fertiliser (Haber–Bosch requires H\_\{2\} + N\_\{2\}) \\
  \textbf{H\_\{2\}O (ice)} & Subsurface ice deposits & Variable by
  location & Water, H\_\{2\} (electrolysis), O\_\{2\} \\
  \textbf{Ar (argon)} & Atmosphere (1.6\%) & Available & Inert gas for
  welding, fire suppression \\
  \textbf{Al\_\{2\}O\_\{3\}, TiO\_\{2\}, MgO} & Regolith & Minor
  components & Aluminium, titanium extraction (long-term) \\
  \end{longtable}
  
  \paragraph{8.2 ISRU Processing Chain}\label{isru-processing-chain}
  
  \textbf{Phase 1 (from Sol 1): Atmospheric Processing} - CO\_\{2\}
  collection + Sabatier reaction: CO\_\{2\} + 4H\_\{2\} → CH\_\{4\} +
  2H\_\{2\}O - Produces methane (fuel/heating) + water - Water
  electrolysis: 2H\_\{2\}O → 2H\_\{2\} + O\_\{2\} - Oxygen for atmosphere;
  hydrogen recycled to Sabatier
  
  \textbf{Phase 2 (from Sol 100): Regolith Processing} - Regolith
  collection by robotic systems
  (\href{https://doi.org/10.5281/zenodo.15455156}{DOI:
  10.5281/zenodo.15455156}) - Silica extraction for glass repair and
  silicone rubber production - Iron oxide reduction for basic metal tools
  - Regolith sintering for construction bricks
  
  \textbf{Phase 3 (from Sol 300): Chemical Manufacturing} - Haber–Bosch
  process (N\_\{2\} + H\_\{2\} → NH\_\{3\}) — requires significant energy
  but enables fertiliser independence - Perchlorate reduction from
  regolith — detoxification of Martian soil for agriculture - Water
  extraction from subsurface ice deposits
  
