  Nebenbestandteile & Aluminium-, Titan-Extraktion (langfristig) \\
  \end{longtable}
  
  \paragraph{8.2 ISRU-Prozesskette}\label{isru-prozesskette}
  
  \textbf{Phase 1 (ab Sol 1): Atmosphärenverarbeitung} -
  CO\_\{2\}-Sammlung + Sabatier-Reaktion: CO\_\{2\} + 4H\_\{2\} →
  CH\_\{4\} + 2H\_\{2\}O - Produziert Methan (Brennstoff/Heizung) + Wasser
  - Wasserelektrolyse: 2H\_\{2\}O → 2H\_\{2\} + O\_\{2\} - Sauerstoff für
  Atmosphäre; Wasserstoff wird zum Sabatier-Reaktor zurückgeführt
  
  \textbf{Phase 2 (ab Sol 100): Regolith-Verarbeitung} - Regolith-Sammlung
  durch Robotersysteme
  (\href{https://doi.org/10.5281/zenodo.15455156}{DOI:
  10.5281/zenodo.15455156}) - Silika-Extraktion für Glasreparatur und
  Silikonkautschuk-Produktion - Eisenoxid-Reduktion für einfache
  Metallwerkzeuge - Regolith-Sintern für Baumaterialsteine
  
  \textbf{Phase 3 (ab Sol 300): Chemische Fertigung} -
  Haber-Bosch-Verfahren (N\_\{2\} + H\_\{2\} → NH\_\{3\}) — erfordert
  erhebliche Energie, ermöglicht aber Düngerunabhängigkeit -
  Perchlorat-Reduktion aus Regolith — Entgiftung von Marsboden für die
  Landwirtschaft - Wassergewinnung aus unterirdischen Eisvorkommen
  
  \paragraph{8.3
  ISRU-Anlagen-Anforderungen}\label{isru-anlagen-anforderungen}
  
