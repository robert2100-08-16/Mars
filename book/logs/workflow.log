  \subsubsection{Build Instructions}\label{build-instructions}
  
  \begin{Shaded}
  \begin{Highlighting}[]
  \CommentTok{\# Prerequisites: Python ≥ 3.10, Pandoc, TeX Live (LuaLaTeX)}
  \ExtensionTok{pip}\NormalTok{ install gitbook{-}worker}
  
  \CommentTok{\# Build English PDF}
  \BuiltInTok{cd}\NormalTok{ book/}
  \ExtensionTok{gitbook{-}worker}\NormalTok{ run }\AttributeTok{{-}{-}lang}\NormalTok{ en }\AttributeTok{{-}{-}profile}\NormalTok{ local}
  
  \CommentTok{\# Build German PDF}
